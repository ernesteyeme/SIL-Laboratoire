# --- Base de données ---
DATABASE_URL="postgresql://lims:lims_dev_password@localhost:5432/lims?schema=public"

# --- Serveur ---
NODE_ENV=development
PORT=3000
# Origines autorisées (séparées par des virgules) pour le frontend
CORS_ORIGINS=http://localhost:5173
# Mettre à true derrière un reverse proxy (Nginx, Traefik) pour obtenir la vraie IP client
TRUST_PROXY=false

# --- Authentification ---
# Secret d'au moins 32 caractères. Générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=remplacer_par_un_secret_long_et_aleatoire_de_48_caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# true obligatoire en production (HTTPS)
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Initialisation (seed) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FULLNAME=Administrateur système
SEED_ADMIN_PASSWORD=Admin@Lims2026!
SEED_LAB_NAME=Laboratoire d'Analyses Médicales

# Étape 7 — Interopérabilité DHIS2 / VLSM / OpenHIM
# Clé AES-256-GCM chiffrant les mots de passe et jetons des connexions (32 octets).
# Générer : openssl rand -hex 32 — à sauvegarder avec la base : sans elle, les secrets enregistrés sont irrécupérables.
INTEROP_SECRET_KEY=
