/// Taux du jour (CDF pour 1 USD), un par date locale du laboratoire. Modifications auditées ;
/// chaque paiement fige le taux appliqué.
model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  effectiveDate DateTime @unique @map("effective_date") @db.Date
  cdfPerUsd     Decimal  @map("cdf_per_usd") @db.Decimal(14, 4)
  note          String?  @db.VarChar(300)
  setById       String   @map("set_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("exchange_rates")
}

// =====================================================================
// Étape 4 — Résultats, validation, comptes rendus
// =====================================================================

enum AnalysisStatus {
  AWAITING_SAMPLE
  TO_ENTER
  ENTERED
  TECHNICAL_VALIDATED
  VALIDATED
}

enum ResultFlag {
  CRITICAL_LOW
  LOW
  NORMAL
  HIGH
  CRITICAL_HIGH
  ABNORMAL
}

enum ReportKind {
  PARTIAL
  FINAL
  AMENDED
}

/// Un résultat par (examen demandé × paramètre). Paramètre et valeur de référence sont figés
/// à la création (le catalogue peut évoluer sans modifier les résultats existants).
model TestResult {
  id            String      @id @default(uuid()) @db.Uuid
  orderItemId   String      @map("order_item_id") @db.Uuid
  parameterId   String      @map("parameter_id") @db.Uuid
  parameterCode String      @map("parameter_code") @db.VarChar(30)
  parameterName String      @map("parameter_name") @db.VarChar(150)
  unit          String?     @db.VarChar(30)
  resultType    ResultType  @map("result_type")
  decimals      Int?
  choices       String[]
  displayOrder  Int         @default(0) @map("display_order")
  numericValue  Decimal?    @map("numeric_value") @db.Decimal(18, 4)
  /// « < » ou « > » : limite de détection / quantification.
  qualifier     String?     @db.VarChar(1)
  textValue     String?     @map("text_value") @db.VarChar(500)
  flag          ResultFlag?
  hasReference  Boolean     @default(false) @map("has_reference")
  refLow        Decimal?    @map("ref_low") @db.Decimal(14, 4)
  refHigh       Decimal?    @map("ref_high") @db.Decimal(14, 4)
  refCriticalLow  Decimal?  @map("ref_critical_low") @db.Decimal(14, 4)
  refCriticalHigh Decimal?  @map("ref_critical_high") @db.Decimal(14, 4)
  refNormalText String?     @map("ref_normal_text") @db.VarChar(100)
  refComment    String?     @map("ref_comment") @db.VarChar(300)
  refLabel      String?     @map("ref_label") @db.VarChar(100)
  comment       String?     @db.VarChar(500)
  enteredById   String?     @map("entered_by_id") @db.Uuid
  enteredAt     DateTime?   @map("entered_at") @db.Timestamptz(6)
  /// Origine de la valeur : saisie manuelle ou automate (et lequel).
  source       ResultSource @default(MANUAL)
  instrumentId String?      @map("instrument_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  parameter ExamParameter   @relation(fields: [parameterId], references: [id], onDelete: Restrict)
  alerts    CriticalAlert[]

  @@unique([orderItemId, parameterId])
  @@index([parameterId])
  @@map("test_results")
}

/// Résultat critique : sa communication (qui, quand, à qui) doit être tracée avant validation (ISO 15189 §7.4.1.3).
model CriticalAlert {
  id               String     @id @default(uuid()) @db.Uuid
  resultId         String     @map("result_id") @db.Uuid
  orderItemId      String     @map("order_item_id") @db.Uuid
  flag             ResultFlag
  valueText        String     @map("value_text") @db.VarChar(60)
  detectedAt       DateTime   @default(now()) @map("detected_at") @db.Timestamptz(6)
  detectedById     String     @map("detected_by_id") @db.Uuid
  acknowledgedAt   DateTime?  @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedById String?    @map("acknowledged_by_id") @db.Uuid
  notifiedTo       String?    @map("notified_to") @db.VarChar(200)
  note             String?    @db.VarChar(500)
  /// Alerte devenue sans objet (valeur corrigée avant communication).
  cancelledAt      DateTime?  @map("cancelled_at") @db.Timestamptz(6)

  result    TestResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([acknowledgedAt])
  @@map("critical_alerts")
}

/// Trace d'une correction après validation biologique : valeurs remplacées et motif.
model ResultAmendment {
  id              String   @id @default(uuid()) @db.Uuid
  orderItemId     String   @map("order_item_id") @db.Uuid
  fromVersion     Int      @map("from_version")
  previousResults Json     @map("previous_results")
  reason          String   @db.VarChar(500)
  amendedById     String   @map("amended_by_id") @db.Uuid
  amendedAt       DateTime @default(now()) @map("amended_at") @db.Timestamptz(6)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@map("result_amendments")
}

/// Compte rendu émis : PDF figé, empreinte SHA-256, non modifiable (trigger). Archivage ISO 15189 §7.4.1.7 / §8.4.
model Report {
  id           String     @id @default(uuid()) @db.Uuid
  /// CR-2026-000001
  number       String     @unique @db.VarChar(20)
  orderId      String     @map("order_id") @db.Uuid
  version      Int
  kind         ReportKind
  sha256       String     @db.VarChar(64)
  pdf          Bytes
  orderItemIds String[]   @map("order_item_ids")
  examCodes    String[]   @map("exam_codes")
  issuedAt     DateTime   @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById   String     @map("issued_by_id") @db.Uuid
  supersedesId String?    @unique @map("supersedes_id") @db.Uuid

  order      LabOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  supersedes Report?  @relation("ReportSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Report? @relation("ReportSupersession")

  @@unique([orderId, version])
  @@map("reports")
}

// =====================================================================
// Étape 5 — Qualité : contrôle qualité interne, non-conformités
// =====================================================================

enum QcStatus {
  ACCEPTED
  WARNING
  REJECTED
}

enum QcTargetSource {
  MANUFACTURER
  LABORATORY
}

enum QualityIssueCategory {
  PRE_ANALYTICAL
  ANALYTICAL
  POST_ANALYTICAL
  EQUIPMENT
  REAGENT
  COMPLAINT
  SAFETY
  OTHER
}

enum QualityIssueSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum QualityIssueStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

/// Lot de matériau de contrôle (un niveau).
model QcMaterial {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  manufacturer String?  @db.VarChar(150)
  lotNumber    String   @map("lot_number") @db.VarChar(60)
  level        String   @db.VarChar(40)
  expiresOn    DateTime @map("expires_on") @db.Date
  sectionId    String?  @map("section_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  section LabSection? @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  targets QcTarget[]
  instrumentLinks InstrumentQcMaterial[]

  @@unique([name, lotNumber, level])
  @@map("qc_materials")
}

/// Valeur cible (moyenne, écart-type) d'un matériau pour un paramètre.
model QcTarget {
  id          String         @id @default(uuid()) @db.Uuid
  materialId  String         @map("material_id") @db.Uuid
  parameterId String         @map("parameter_id") @db.Uuid
  mean        Decimal        @db.Decimal(14, 4)
  sd          Decimal        @db.Decimal(14, 4)
  source      QcTargetSource
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  material  QcMaterial    @relation(fields: [materialId], references: [id], onDelete: Restrict)
  parameter ExamParameter @relation(fields: [parameterId], references: [id], onDelete: Restrict)
  results   QcResult[]

  @@unique([materialId, parameterId])
  @@index([parameterId])
  @@map("qc_targets")
}

/// Série de contrôle d'un paramètre (un résultat par niveau), évaluée par les règles de Westgard.
model QcRun {
  id               String    @id @default(uuid()) @db.Uuid
  parameterId      String    @map("parameter_id") @db.Uuid
  performedAt      DateTime  @map("performed_at") @db.Timestamptz(6)
  performedById    String    @map("performed_by_id") @db.Uuid
  status           QcStatus
  violatedRules    String[]  @map("violated_rules")
  comment          String?   @db.VarChar(500)
  correctiveAction String?   @map("corrective_action") @db.VarChar(1000)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedById     String?   @map("resolved_by_id") @db.Uuid
  /// Série écartée des statistiques et de l'évaluation des séries suivantes (erreur de saisie, mauvais lot…).
  excludedAt       DateTime? @map("excluded_at") @db.Timestamptz(6)
  excludedById     String?   @map("excluded_by_id") @db.Uuid
  excludedReason   String?   @map("excluded_reason") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  parameter    ExamParameter @relation(fields: [parameterId], references: [id], onDelete: Restrict)
  results      QcResult[]
  qualityIssue QualityIssue?

  @@index([parameterId, performedAt])
  @@index([status])
  @@map("qc_runs")
}

model QcResult {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @map("run_id") @db.Uuid
  targetId      String   @map("target_id") @db.Uuid
  value         Decimal  @db.Decimal(18, 4)
  /// Cible figée au moment du passage
  mean          Decimal  @db.Decimal(14, 4)
  sd            Decimal  @db.Decimal(14, 4)
  zScore        Decimal  @map("z_score") @db.Decimal(9, 3)
  status        QcStatus
  violatedRules String[] @map("violated_rules")

  run    QcRun    @relation(fields: [runId], references: [id], onDelete: Restrict)
  target QcTarget @relation(fields: [targetId], references: [id], onDelete: Restrict)

  @@unique([runId, targetId])
  @@index([targetId])
  @@map("qc_results")
}

/// Fiche de non-conformité (ISO 15189 §7.5) et actions correctives (§8.7).
model QualityIssue {
  id                 String               @id @default(uuid()) @db.Uuid
  /// NC-2026-0001
  number             String               @unique @db.VarChar(20)
  title              String               @db.VarChar(200)
  category           QualityIssueCategory
  severity           QualityIssueSeverity
  status             QualityIssueStatus   @default(OPEN)
  description        String               @db.VarChar(4000)
  detectedAt         DateTime             @map("detected_at") @db.Timestamptz(6)
  declaredAt         DateTime             @default(now()) @map("declared_at") @db.Timestamptz(6)
  declaredById       String               @map("declared_by_id") @db.Uuid
  immediateAction    String?              @map("immediate_action") @db.VarChar(2000)
  orderId            String?              @map("order_id") @db.Uuid
  sampleId           String?              @map("sample_id") @db.Uuid
  qcRunId            String?              @unique @map("qc_run_id") @db.Uuid
  rootCause          String?              @map("root_cause") @db.VarChar(2000)
  correctiveAction   String?              @map("corrective_action") @db.VarChar(2000)
  actionOwner        String?              @map("action_owner") @db.VarChar(150)
  actionDueDate      DateTime?            @map("action_due_date") @db.Date
  analyzedById       String?              @map("analyzed_by_id") @db.Uuid
  analyzedAt         DateTime?            @map("analyzed_at") @db.Timestamptz(6)
  effectivenessCheck String?              @map("effectiveness_check") @db.VarChar(2000)
  closedById         String?              @map("closed_by_id") @db.Uuid
  closedAt           DateTime?            @map("closed_at") @db.Timestamptz(6)
  cancelledReason    String?              @map("cancelled_reason") @db.VarChar(500)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  order  LabOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sample Sample?   @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  qcRun  QcRun?    @relation(fields: [qcRunId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([declaredAt])
  @@map("quality_issues")
}

// =====================================================================
// Étape 6 — Interfaçage des automates
// =====================================================================

enum InstrumentProtocol {
  ASTM
  HL7
  CSV
}

enum InstrumentMessageStatus {
  PROCESSED
  PARTIAL
  FAILED
}

enum InstrumentMessageSource {
  GATEWAY
  UPLOAD
}

enum InstrumentResultKind {
  PATIENT
  QC
}

enum InstrumentResultStatus {
  APPLIED
  QC_APPLIED
  CONFLICT
  UNMATCHED
  LOCKED
  NOT_PERFORMED
  DISMISSED
}

enum ResultSource {
  MANUAL
  INSTRUMENT
}

model Instrument {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique @db.VarChar(30)
  name             String             @db.VarChar(120)
  manufacturer     String?            @db.VarChar(120)
  model            String?            @db.VarChar(120)
  sectionId        String?            @map("section_id") @db.Uuid
  protocol         InstrumentProtocol
  csvConfig        Json?              @map("csv_config")
  isActive         Boolean            @default(true) @map("is_active")
  /// Compte de service (sans rôle, non connectable) qui porte les actions de l'automate dans l'audit.
  serviceUserId    String             @unique @map("service_user_id") @db.Uuid
  /// Empreinte SHA-256 de la clé d'API (la clé elle-même n'est jamais stockée).
  apiKeyHash       String?            @unique @map("api_key_hash") @db.VarChar(64)
  apiKeyPrefix     String?            @map("api_key_prefix") @db.VarChar(48)
  apiKeyRotatedAt  DateTime?          @map("api_key_rotated_at") @db.Timestamptz(6)
  lastMessageAt    DateTime?          @map("last_message_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  section     LabSection?             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  serviceUser User                    @relation(fields: [serviceUserId], references: [id], onDelete: Restrict)
  mappings    InstrumentTestMapping[]
  qcMaterials InstrumentQcMaterial[]
  messages    InstrumentMessage[]
  results     InstrumentResult[]

  @@map("instruments")
}

model InstrumentTestMapping {
  id             String   @id @default(uuid()) @db.Uuid
  instrumentId   String   @map("instrument_id") @db.Uuid
  instrumentCode String   @map("instrument_code") @db.VarChar(40)
  parameterId    String   @map("parameter_id") @db.Uuid
  factor         Decimal  @default(1) @db.Decimal(14, 6)
  valueMap       Json     @default("{}") @map("value_map")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  instrument Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  parameter  ExamParameter @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  @@unique([instrumentId, instrumentCode])
  @@map("instrument_test_mappings")
}

model InstrumentQcMaterial {
  id           String   @id @default(uuid()) @db.Uuid
  instrumentId String   @map("instrument_id") @db.Uuid
  specimenId   String   @map("specimen_id") @db.VarChar(60)
  materialId   String   @map("material_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  material   QcMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([instrumentId, specimenId])
  @@map("instrument_qc_materials")
}

/// Message brut reçu, conservé à l'identique (traçabilité) ; une retransmission identique est reconnue par son empreinte.
model InstrumentMessage {
  id           String                  @id @default(uuid()) @db.Uuid
  instrumentId String                  @map("instrument_id") @db.Uuid
  protocol     InstrumentProtocol
  source       InstrumentMessageSource
  filename     String?                 @db.VarChar(200)
  raw          String
  sha256       String                  @db.VarChar(64)
  receivedAt   DateTime                @default(now()) @map("received_at") @db.Timestamptz(6)
  receivedById String                  @map("received_by_id") @db.Uuid
  status       InstrumentMessageStatus
  error        String?                 @db.VarChar(1000)
  warnings     String[]
  resultCount  Int                     @default(0) @map("result_count")
  appliedCount Int                     @default(0) @map("applied_count")

  instrument Instrument         @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  results    InstrumentResult[]

  @@unique([instrumentId, sha256])
  @@index([receivedAt])
  @@map("instrument_messages")
}

model InstrumentResult {
  id                 String                 @id @default(uuid()) @db.Uuid
  messageId          String                 @map("message_id") @db.Uuid
  instrumentId       String                 @map("instrument_id") @db.Uuid
  kind               InstrumentResultKind
  specimenId         String                 @map("specimen_id") @db.VarChar(60)
  instrumentTestCode String                 @map("instrument_test_code") @db.VarChar(40)
  rawValue           String                 @map("raw_value") @db.VarChar(100)
  unit               String?                @db.VarChar(30)
  flags              String?                @db.VarChar(20)
  measuredAt         DateTime?              @map("measured_at") @db.Timestamptz(6)
  status             InstrumentResultStatus
  reason             String?                @db.VarChar(300)
  parameterId        String?                @map("parameter_id") @db.Uuid
  testResultId       String?                @map("test_result_id") @db.Uuid
  qcRunId            String?                @map("qc_run_id") @db.Uuid
  resolvedById       String?                @map("resolved_by_id") @db.Uuid
  resolvedAt         DateTime?              @map("resolved_at") @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  message    InstrumentMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  instrument Instrument        @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([status])
  @@index([specimenId])
  @@map("instrument_results")
}

// =====================================================================
// Étape 7 — Interopérabilité : DHIS2 (agrégats), VLSM/InteLIS (résultats CV/EID), OpenHIM
// =====================================================================

enum InteropSystem {
  DHIS2
  VLSM
}

enum InteropTransport {
  DIRECT
  OPENHIM
}

enum InteropAuthMode {
  BASIC
  TOKEN
}

enum Dhis2Measure {
  VALIDATED_COUNT
  NUMERIC_BELOW
  NUMERIC_AT_OR_ABOVE
  TEXT_EQUALS
}

enum VlsmTestType {
  VL
  EID
}

enum InteropRunKind {
  CONNECTION_TEST
  DHIS2_DRY_RUN
  DHIS2_SEND
  VLSM_SEND
}

enum InteropRunStatus {
  SUCCESS
  WARNING
  ERROR
}

enum VlsmSubmissionStatus {
  SENT
  FAILED
}

/// Système distant (DHIS2 ou VLSM), joint directement ou au travers d'un canal OpenHIM.
model InteropEndpoint {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(30)
  name            String           @db.VarChar(120)
  system          InteropSystem
  transport       InteropTransport
  baseUrl         String           @map("base_url") @db.VarChar(500)
  authMode        InteropAuthMode  @map("auth_mode")
  username        String?          @db.VarChar(120)
  /// Secret chiffré (AES-256-GCM, clé INTEROP_SECRET_KEY) : jamais renvoyé par l'API.
  secretCipher    String?          @map("secret_cipher")
  timeoutSeconds  Int              @default(30) @map("timeout_seconds")
  isActive        Boolean          @default(true) @map("is_active")
  settings        Json
  lastTestAt      DateTime?        @map("last_test_at") @db.Timestamptz(6)
  lastTestOk      Boolean?         @map("last_test_ok")
  lastTestMessage String?          @map("last_test_message") @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  dhis2Mappings Dhis2Mapping[]
  vlsmMappings  VlsmMapping[]
  runs          InteropRun[]
  submissions   VlsmSubmission[]

  @@map("interop_endpoints")
}

/// Règle de calcul d'une valeur DHIS2 (élément de données × combinaison de catégories) à partir des résultats validés.
model Dhis2Mapping {
  id                  String       @id @default(uuid()) @db.Uuid
  endpointId          String       @map("endpoint_id") @db.Uuid
  label               String       @db.VarChar(150)
  parameterId         String       @map("parameter_id") @db.Uuid
  measure             Dhis2Measure
  threshold           Decimal?     @db.Decimal(18, 4)
  textMatch           String?      @map("text_match") @db.VarChar(100)
  sex                 RangeSex     @default(ANY)
  ageMinYears         Int?         @map("age_min_years")
  ageMaxYears         Int?         @map("age_max_years")
  dataElement         String       @map("data_element") @db.VarChar(11)
  categoryOptionCombo String?      @map("category_option_combo") @db.VarChar(11)
  displayOrder        Int          @default(0) @map("display_order")
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  endpoint  InteropEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  parameter ExamParameter   @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  @@index([endpointId])
  @@map("dhis2_mappings")
}

/// Paramètre du catalogue transmis à VLSM comme résultat de charge virale (VL) ou de diagnostic précoce (EID).
model VlsmMapping {
  id               String       @id @default(uuid()) @db.Uuid
  endpointId       String       @map("endpoint_id") @db.Uuid
  parameterId      String       @map("parameter_id") @db.Uuid
  testType         VlsmTestType @map("test_type")
  eidPositive      String?      @map("eid_positive") @db.VarChar(100)
  eidNegative      String?      @map("eid_negative") @db.VarChar(100)
  eidIndeterminate String?      @map("eid_indeterminate") @db.VarChar(100)
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  endpoint  InteropEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  parameter ExamParameter   @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  @@unique([endpointId, parameterId])
  @@map("vlsm_mappings")
}

/// Journal immuable des échanges (test, simulation, envoi) : charge utile, empreinte et réponse du système distant.
model InteropRun {
  id                   String           @id @default(uuid()) @db.Uuid
  endpointId           String           @map("endpoint_id") @db.Uuid
  kind                 InteropRunKind
  status               InteropRunStatus
  period               String?          @db.VarChar(6)
  itemCount            Int              @default(0) @map("item_count")
  payload              Json?
  payloadSha256        String?          @map("payload_sha256") @db.VarChar(64)
  httpStatus           Int?             @map("http_status")
  openhimTransactionId String?          @map("openhim_transaction_id") @db.VarChar(100)
  imported             Int?
  updated              Int?
  ignored              Int?
  deleted              Int?
  conflicts            Json?
  message              String?          @db.VarChar(1000)
  durationMs           Int              @default(0) @map("duration_ms")
  triggeredById        String?          @map("triggered_by_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  endpoint    InteropEndpoint  @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  submissions VlsmSubmission[]

  @@index([endpointId, createdAt])
  @@index([kind, period])
  @@map("interop_runs")
}

/// Envoi d'un résultat validé (à une version donnée de l'examen) vers VLSM.
model VlsmSubmission {
  id               String               @id @default(uuid()) @db.Uuid
  endpointId       String               @map("endpoint_id") @db.Uuid
  runId            String               @map("run_id") @db.Uuid
  orderItemId      String               @map("order_item_id") @db.Uuid
  itemVersion      Int                  @map("item_version")
  status           VlsmSubmissionStatus
  uniqueId         String               @map("unique_id") @db.VarChar(64)
  remoteSampleCode String?              @map("remote_sample_code") @db.VarChar(100)
  message          String?              @db.VarChar(500)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  endpoint  InteropEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  run       InteropRun      @relation(fields: [runId], references: [id], onDelete: Restrict)
  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([endpointId, orderItemId])
  @@index([runId])
  @@map("vlsm_submissions")
}

// =====================================================================
// Version 1.8.0 — Habilitations par service (ISO 15189 §6.2)
// =====================================================================

/// Service (section) où un technicien ou un biologiste est habilité à saisir et valider.
model UserSection {
  userId      String   @map("user_id") @db.Uuid
  sectionId   String   @map("section_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedById String?  @map("granted_by_id") @db.Uuid

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  section LabSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@id([userId, sectionId])
  @@index([sectionId])
  @@map("user_sections")
}
