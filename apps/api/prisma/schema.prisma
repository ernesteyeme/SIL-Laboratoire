// Schéma du socle (étape 1) : utilisateurs, sessions, piste d'audit, paramètres.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RECEPTION
  CAISSE
  TECHNICIEN
  BIOLOGISTE
  QUALITE
  COMPTABLE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  ACCESS_DENIED
  TOKEN_REUSE_DETECTED
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(50)
  email              String?   @unique @db.VarChar(254)
  fullName           String    @map("full_name") @db.VarChar(120)
  passwordHash       String    @map("password_hash")
  roles              Role[]
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  /// Incrémenté à chaque changement/réinitialisation de mot de passe ou désactivation :
  /// invalide immédiatement tous les jetons d'accès émis auparavant.
  tokenVersion       Int       @default(0) @map("token_version")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        String?   @map("created_by_id") @db.Uuid
  deactivatedAt      DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedById    String?   @map("deactivated_by_id") @db.Uuid
  deactivationReason String?   @map("deactivation_reason") @db.VarChar(500)
  /// Compte technique d'un automate : aucun rôle, connexion refusée, absent de la liste des utilisateurs.
  isServiceAccount   Boolean   @default(false) @map("is_service_account")

  refreshTokens RefreshToken[]
  instrument    Instrument?

  sections UserSection[]

  @@map("users")
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Toutes les rotations d'une même connexion partagent la même famille.
  familyId      String    @map("family_id") @db.Uuid
  /// SHA-256 du secret ; le secret en clair n'est jamais stocké.
  tokenHash     String    @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(32)
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  ip            String?   @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Piste d'audit en ajout seul. `seq`, `occurred_at`, `prev_hash` et `hash`
/// sont calculés par un trigger PostgreSQL (voir migration 0001) ;
/// UPDATE, DELETE et TRUNCATE sont bloqués au niveau de la base.
model AuditLog {
  id            BigInt      @id @default(autoincrement())
  seq           BigInt      @unique @default(0)
  occurredAt    DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId       String?     @map("actor_id") @db.Uuid
  actorUsername String?     @map("actor_username") @db.VarChar(50)
  actorRoles    Role[]      @map("actor_roles")
  action        AuditAction
  entity        String      @db.VarChar(64)
  entityId      String      @map("entity_id") @db.VarChar(64)
  before        Json?
  after         Json?
  reason        String?     @db.VarChar(500)
  requestId     String?     @map("request_id") @db.VarChar(64)
  ip            String?     @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.VarChar(500)
  prevHash      String?     @map("prev_hash") @db.VarChar(64)
  hash          String      @default("") @db.VarChar(64)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([occurredAt])
  @@index([action])
  @@map("audit_log")
}

/// Paramètres du laboratoire : une seule ligne (id = 1).
model LabSettings {
  id                  Int      @id @default(1)
  name                String   @db.VarChar(200)
  shortName           String?  @map("short_name") @db.VarChar(50)
  address             String?  @db.VarChar(300)
  city                String?  @db.VarChar(100)
  country             String?  @db.VarChar(100)
  phone               String?  @db.VarChar(50)
  email               String?  @db.VarChar(254)
  accreditationNumber String?  @map("accreditation_number") @db.VarChar(100)
  accreditationBody   String?  @map("accreditation_body") @db.VarChar(200)
  directorName        String?  @map("director_name") @db.VarChar(200)
  reportFooter        String?  @map("report_footer") @db.VarChar(2000)
  currency            String   @default("CDF") @db.VarChar(3)
  timezone            String   @default("Africa/Kinshasa") @db.VarChar(64)
  /// Prélèvement autorisé seulement après paiement complet (sauf demande urgente).
  requirePaymentBeforeCollection Boolean @default(false) @map("require_payment_before_collection")
  /// Caisse bi-devise CDF/USD (devise de base = currency, l'autre au taux du jour).
  secondaryCurrencyEnabled       Boolean @default(false) @map("secondary_currency_enabled")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById         String?  @map("updated_by_id") @db.Uuid

  @@map("lab_settings")
}

// =====================================================================
// Étape 2 — Référentiels : patients, prescripteurs, catalogue
// =====================================================================

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

enum RangeSex {
  ANY
  MALE
  FEMALE
}

enum ResultType {
  NUMERIC
  TEXT
  CHOICE
}

model Patient {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Identifiant patient unique attribué par la base (PAT-000001).
  code               String    @unique @default(dbgenerated("('PAT-'::text || lpad((nextval('patient_code_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(20)
  lastName           String    @map("last_name") @db.VarChar(80)
  middleName         String?   @map("middle_name") @db.VarChar(80)
  firstName          String?   @map("first_name") @db.VarChar(80)
  /// Jetons du nom normalisés et triés (recherche et détection des doublons).
  searchName         String    @map("search_name") @db.VarChar(300)
  sex                Sex
  birthDate          DateTime? @map("birth_date") @db.Date
  birthDateEstimated Boolean   @default(false) @map("birth_date_estimated")
  phone              String?   @db.VarChar(30)
  /// 9 derniers chiffres du téléphone (comparaison indépendante du format).
  phoneKey           String?   @map("phone_key") @db.VarChar(9)
  email              String?   @db.VarChar(254)
  address            String?   @db.VarChar(300)
  city               String?   @db.VarChar(100)
  externalId         String?   @map("external_id") @db.VarChar(50)
  notes              String?   @db.VarChar(1000)
  isActive           Boolean   @default(true) @map("is_active")
  deactivatedAt      DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedById    String?   @map("deactivated_by_id") @db.Uuid
  deactivationReason String?   @map("deactivation_reason") @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        String?   @map("created_by_id") @db.Uuid
  updatedById        String?   @map("updated_by_id") @db.Uuid

  orders   LabOrder[]
  invoices Invoice[]

  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phoneKey])
  @@index([externalId])
  @@index([createdAt])
  @@map("patients")
}

model Prescriber {
  id                 String    @id @default(uuid()) @db.Uuid
  title              String?   @db.VarChar(20)
  lastName           String    @map("last_name") @db.VarChar(80)
  firstName          String?   @map("first_name") @db.VarChar(80)
  searchName         String    @map("search_name") @db.VarChar(300)
  specialty          String?   @db.VarChar(100)
  facility           String?   @db.VarChar(150)
  phone              String?   @db.VarChar(30)
  email              String?   @db.VarChar(254)
  licenseNumber      String?   @unique @map("license_number") @db.VarChar(50)
  isActive           Boolean   @default(true) @map("is_active")
  deactivationReason String?   @map("deactivation_reason") @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders LabOrder[]

  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("prescribers")
}

model LabSection {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(20)
  name         String   @db.VarChar(100)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exams Exam[]
  qcMaterials QcMaterial[]
  instruments Instrument[]
  users       UserSection[]

  @@map("lab_sections")
}

model SampleType {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(20)
  name         String   @db.VarChar(100)
  container    String?  @db.VarChar(100)
  instructions String?  @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exams   Exam[]
  samples Sample[]

  @@map("sample_types")
}

model Exam {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(20)
  name                String   @db.VarChar(150)
  shortName           String?  @map("short_name") @db.VarChar(30)
  sectionId           String   @map("section_id") @db.Uuid
  sampleTypeId        String   @map("sample_type_id") @db.Uuid
  price               Decimal  @db.Decimal(12, 2)
  turnaroundHours     Int      @map("turnaround_hours")
  patientInstructions String?  @map("patient_instructions") @db.VarChar(500)
  displayOrder        Int      @default(0) @map("display_order")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  section    LabSection      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  sampleType SampleType      @relation(fields: [sampleTypeId], references: [id], onDelete: Restrict)
  parameters ExamParameter[]
  orderItems OrderItem[]

  @@index([sectionId])
  @@index([sampleTypeId])
  @@map("exams")
}

model ExamParameter {
  id           String     @id @default(uuid()) @db.Uuid
  examId       String     @map("exam_id") @db.Uuid
  code         String     @db.VarChar(30)
  name         String     @db.VarChar(150)
  resultType   ResultType @map("result_type")
  unit         String?    @db.VarChar(30)
  decimals     Int?
  choices      String[]
  displayOrder Int        @default(0) @map("display_order")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam            Exam             @relation(fields: [examId], references: [id], onDelete: Restrict)
  referenceRanges ReferenceRange[]
  results         TestResult[]
  qcTargets       QcTarget[]
  qcRuns          QcRun[]
  instrumentMappings InstrumentTestMapping[]
  dhis2Mappings      Dhis2Mapping[]
  vlsmMappings       VlsmMapping[]

  @@unique([examId, code])
  @@map("exam_parameters")
}

model ReferenceRange {
  id           String   @id @default(uuid()) @db.Uuid
  parameterId  String   @map("parameter_id") @db.Uuid
  sex          RangeSex @default(ANY)
  /// Tranche d'âge [ageMinDays, ageMaxDays[ en jours ; ageMaxDays null = sans limite.
  ageMinDays   Int      @default(0) @map("age_min_days")
  ageMaxDays   Int?     @map("age_max_days")
  low          Decimal? @db.Decimal(14, 4)
  high         Decimal? @db.Decimal(14, 4)
  criticalLow  Decimal? @map("critical_low") @db.Decimal(14, 4)
  criticalHigh Decimal? @map("critical_high") @db.Decimal(14, 4)
  normalText   String?  @map("normal_text") @db.VarChar(100)
  comment      String?  @db.VarChar(300)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parameter ExamParameter @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  @@index([parameterId])
  @@map("reference_ranges")
}

// =====================================================================
// Étape 3 — Demandes, échantillons, facturation, caisse
// =====================================================================

enum OrderPriority {
  ROUTINE
  URGENT
}

enum OrderStatus {
  REGISTERED
  PARTIALLY_COLLECTED
  COLLECTED
  RECEIVED
  CANCELLED
  PARTIALLY_VALIDATED
  VALIDATED
}

enum SampleStatus {
  PENDING_COLLECTION
  COLLECTED
  RECEIVED
  REJECTED
}

enum NonConformityType {
  HEMOLYZED
  CLOTTED
  INSUFFICIENT_VOLUME
  WRONG_CONTAINER
  IDENTIFICATION_ERROR
  TRANSPORT_DELAY
  TEMPERATURE
  LEAKED
  CONTAMINATED
  OTHER
}

enum NonConformityDecision {
  REJECTED
  ACCEPTED_WITH_RESERVATION
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

/// Compteurs de numérotation sans trou (demandes, échantillons, factures, reçus, sessions).
/// L'incrément est transactionnel : une transaction annulée ne consomme pas de numéro.
model Counter {
  key    String @db.VarChar(20)
  period String @db.VarChar(10)
  value  Int

  @@id([key, period])
  @@map("counters")
}

model LabOrder {
  id                 String        @id @default(uuid()) @db.Uuid
  number             String        @unique @db.VarChar(20)
  patientId          String        @map("patient_id") @db.Uuid
  prescriberId       String?       @map("prescriber_id") @db.Uuid
  priority           OrderPriority @default(ROUTINE)
  status             OrderStatus   @default(REGISTERED)
  clinicalInfo       String?       @map("clinical_info") @db.VarChar(1000)
  createdById        String        @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      String?       @map("cancelled_by_id") @db.Uuid
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(500)

  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescriber Prescriber? @relation(fields: [prescriberId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  samples    Sample[]
  invoice    Invoice?
  reports    Report[]
  qualityIssues QualityIssue[]

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@map("lab_orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  examId    String   @map("exam_id") @db.Uuid
  /// Instantané du catalogue au moment de la demande (le catalogue peut évoluer ensuite).
  examCode  String   @map("exam_code") @db.VarChar(20)
  examName  String   @map("exam_name") @db.VarChar(150)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  sampleId  String   @map("sample_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Étape 4 : avancement analytique de l'examen.
  analysisStatus         AnalysisStatus @default(AWAITING_SAMPLE) @map("analysis_status")
  technicalValidatedAt   DateTime?      @map("technical_validated_at") @db.Timestamptz(6)
  technicalValidatedById String?        @map("technical_validated_by_id") @db.Uuid
  validatedAt            DateTime?      @map("validated_at") @db.Timestamptz(6)
  validatedById          String?        @map("validated_by_id") @db.Uuid
  /// Incrémenté à chaque correction après validation biologique.
  version                Int            @default(1)
  biologistComment       String?        @map("biologist_comment") @db.VarChar(1000)

  order      LabOrder          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  exam       Exam              @relation(fields: [examId], references: [id], onDelete: Restrict)
  sample     Sample            @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  results    TestResult[]
  alerts     CriticalAlert[]
  amendments ResultAmendment[]
  vlsmSubmissions VlsmSubmission[]

  @@unique([orderId, examId])
  @@index([sampleId])
  @@index([analysisStatus])
  @@map("order_items")
}

model Sample {
  id             String       @id @default(uuid()) @db.Uuid
  /// N° d'échantillon imprimé en code-barres : AAMMJJ + n° du jour (2611220001).
  number         String       @unique @db.VarChar(20)
  orderId        String       @map("order_id") @db.Uuid
  sampleTypeId   String       @map("sample_type_id") @db.Uuid
  status         SampleStatus @default(PENDING_COLLECTION)
  collectedAt    DateTime?    @map("collected_at") @db.Timestamptz(6)
  collectedById  String?      @map("collected_by_id") @db.Uuid
  receivedAt     DateTime?    @map("received_at") @db.Timestamptz(6)
  receivedById   String?      @map("received_by_id") @db.Uuid
  /// Accepté par dérogation malgré une non-conformité (réserve à reporter sur le compte rendu).
  hasReservation Boolean      @default(false) @map("has_reservation")
  rejectedAt     DateTime?    @map("rejected_at") @db.Timestamptz(6)
  /// Échantillon refusé que celui-ci remplace (nouveau prélèvement).
  replacesId     String?      @unique @map("replaces_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  order           LabOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sampleType      SampleType      @relation(fields: [sampleTypeId], references: [id], onDelete: Restrict)
  replaces        Sample?         @relation("SampleReplacement", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy      Sample?         @relation("SampleReplacement")
  items           OrderItem[]
  nonConformities NonConformity[]
  qualityIssues   QualityIssue[]

  @@index([orderId])
  @@index([status])
  @@map("samples")
}

model NonConformity {
  id           String                @id @default(uuid()) @db.Uuid
  sampleId     String                @map("sample_id") @db.Uuid
  type         NonConformityType
  decision     NonConformityDecision
  comment      String?               @db.VarChar(500)
  recordedById String                @map("recorded_by_id") @db.Uuid
  recordedAt   DateTime              @default(now()) @map("recorded_at") @db.Timestamptz(6)

  sample Sample @relation(fields: [sampleId], references: [id], onDelete: Restrict)

  @@index([sampleId])
  @@index([recordedAt])
  @@map("non_conformities")
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  number             String        @unique @db.VarChar(20)
  orderId            String        @unique @map("order_id") @db.Uuid
  patientId          String        @map("patient_id") @db.Uuid
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason     String?       @map("discount_reason") @db.VarChar(500)
  payerName          String?       @map("payer_name") @db.VarChar(150)
  coveragePercent    Int           @default(0) @map("coverage_percent")
  thirdPartyAmount   Decimal       @map("third_party_amount") @db.Decimal(12, 2)
  patientAmount      Decimal       @map("patient_amount") @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status             InvoiceStatus @default(UNPAID)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(500)

  order    LabOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]
  payments Payment[]

  @@index([status])
  @@index([patientId])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  orderItemId String? @unique @map("order_item_id") @db.Uuid
  label       String  @db.VarChar(200)
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  /// N° de reçu : REC-AAAA-000001
  number             String        @unique @db.VarChar(20)
  invoiceId          String        @map("invoice_id") @db.Uuid
  cashSessionId      String        @map("cash_session_id") @db.Uuid
  /// Montant imputé sur la facture, en devise de base.
  amount             Decimal       @db.Decimal(12, 2)
  /// Devise et montant remis par le patient.
  currency           String        @db.VarChar(3)
  tenderedAmount     Decimal       @map("tendered_amount") @db.Decimal(12, 2)
  /// Taux appliqué (CDF pour 1 USD), figé au moment du paiement ; null si devise de base.
  exchangeRate       Decimal?      @map("exchange_rate") @db.Decimal(14, 4)
  /// Monnaie rendue, en devise de base.
  changeAmount       Decimal       @default(0) @map("change_amount") @db.Decimal(12, 2)
  method             PaymentMethod
  reference          String?       @db.VarChar(100)
  receivedById       String        @map("received_by_id") @db.Uuid
  receivedAt         DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      String?       @map("cancelled_by_id") @db.Uuid
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(500)

  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([cashSessionId])
  @@index([receivedAt])
  @@map("payments")
}

model CashSession {
  id           String            @id @default(uuid()) @db.Uuid
  number       String            @unique @db.VarChar(20)
  cashierId    String            @map("cashier_id") @db.Uuid
  status       CashSessionStatus @default(OPEN)
  openedAt     DateTime          @default(now()) @map("opened_at") @db.Timestamptz(6)
  /// Devises figées à l'ouverture (le paramétrage peut changer ensuite).
  baseCurrency String            @default("CDF") @map("base_currency") @db.VarChar(3)
  secondaryCurrency String?      @map("secondary_currency") @db.VarChar(3)
  openingFloat Decimal           @map("opening_float") @db.Decimal(12, 2)
  openingFloatSecondary Decimal  @default(0) @map("opening_float_secondary") @db.Decimal(12, 2)
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz(6)
  expectedCash Decimal?          @map("expected_cash") @db.Decimal(12, 2)
  countedCash  Decimal?          @map("counted_cash") @db.Decimal(12, 2)
  difference   Decimal?          @db.Decimal(12, 2)
  expectedCashSecondary Decimal? @map("expected_cash_secondary") @db.Decimal(12, 2)
  countedCashSecondary  Decimal? @map("counted_cash_secondary") @db.Decimal(12, 2)
  differenceSecondary   Decimal? @map("difference_secondary") @db.Decimal(12, 2)
  closingNote  String?           @map("closing_note") @db.VarChar(500)
  /// Récapitulatif figé à la clôture (totaux par moyen de paiement).
  summary      Json?

  payments Payment[]

  @@index([cashierId, status])
  @@index([openedAt])
  @@map("cash_sessions")
}

// =====================================================================
// Bi-devise : taux de change journalier
