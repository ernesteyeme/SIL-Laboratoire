# Image de l'interface web (Nginx) : fichiers statiques + relais /api vers le conteneur de l'API, en HTTPS.
#   docker build -f docker/Dockerfile.web -t lims-web:1.7.0 lims-1.7.0/
ARG NGINX_IMAGE=nginx:1.27-alpine
FROM ${NGINX_IMAGE}

RUN if command -v apk >/dev/null 2>&1; then apk add --no-cache openssl; \
    else apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*; fi \
 && rm -f /etc/nginx/conf.d/default.conf /etc/nginx/sites-enabled/default

COPY apps/web/dist /usr/share/lims/web
COPY docker/nginx-lims.conf /etc/nginx/conf.d/lims.conf
COPY docker/entrypoint-web.sh /usr/local/bin/lims-web-entrypoint
RUN chmod 0755 /usr/local/bin/lims-web-entrypoint

EXPOSE 80 443
ENTRYPOINT ["/usr/local/bin/lims-web-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
